# ---------------------------------------------------------------------------
# Stryder environment
#
# Copy to .env.local and fill in. NEVER commit a filled-in copy: .env* is
# gitignored apart from this file.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore public. Everything else is server-only.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Supabase project (EU West region — GDPR / EU data residency).
# Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. BYPASSES ROW LEVEL SECURITY.
# Server-only: it is used by Edge Functions and admin scripts and must never
# reach the browser. Do not prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The app's own origin. No domain is hardcoded anywhere in the codebase, so
# this is what OAuth callbacks and email links are built from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: observability -------------------------------------------------
# Both stay completely off unless set. Neither ever receives personal data.

# PostHog (EU cloud). Runs cookieless until a consent banner exists.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry. PII is scrubbed before any event is sent.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# --- Optional: local Supabase Google OAuth -----------------------------------
# Used by supabase/config.toml when running `supabase start`.
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Later phases. Placeholders only — do not implement against these yet.
# ---------------------------------------------------------------------------

# Claude API, for the Monday morning coaching summary.
# ANTHROPIC_API_KEY=

# Strava integration.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Encrypts Strava/Google tokens before they are stored (32 bytes, base64).
# Generate with: openssl rand -base64 32
# Server-only — never prefix this with NEXT_PUBLIC_.
# TOKEN_ENCRYPTION_KEY=

# Google Calendar import.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Stripe billing.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Resend, for transactional email.
# RESEND_API_KEY=
